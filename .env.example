# ── 飞机大战 环境变量示例 ────────────────────────────────────────
# 复制为 .env 后再修改：cp .env.example .env

# SDL 视频驱动：
#   - dummy: 无显示器环境（CI/容器测试），不会真正绘制窗口
#   - x11:   Linux 桌面，配合 X11 转发
#   - cocoa: macOS（直接 Python 运行游戏时无需设置）
#   - windows: Windows（同上）
SDL_VIDEODRIVER=dummy

# SDL 音频驱动：
#   - dummy: 无音频设备
#   - pulse: Linux PulseAudio
#   - alsa:  Linux ALSA
SDL_AUDIODRIVER=dummy

# Linux 桌面运行时使用，X11 显示编号；无图形界面时保持空
DISPLAY=:0

# Python 不缓冲输出，便于在容器中实时查看日志
PYTHONUNBUFFERED=1
